<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SensrActivity">

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initializing..."
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>

    <TextView
        android:id="@+id/inference_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="P_normal=--  P_outage=--  P_transition=--"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/status_text"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>

    <Button
        android:id="@+id/stop_collection_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stop Collection"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/inference_text"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>

    <Button
        android:id="@+id/select_state_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select State"
        app:layout_constraintTop_toBottomOf="@id/inference_text"
        app:layout_constraintStart_toEndOf="@id/stop_collection_button"
        android:layout_margin="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/inference_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <TextView
            android:id="@+id/feature_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Features will appear here..."
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
