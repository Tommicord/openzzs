# Imported targets for openzzs.  Generated by CMake from
# openzzs-targets.cmake.in at configure time.

if (NOT TARGET openzzs::std)
  add_library(openzzs::std STATIC IMPORTED)
  set_target_properties(openzzs::std PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "@CMAKE_INSTALL_FULL_INCLUDEDIR@")
endif ()

if (NOT TARGET openzzs::mllee)
  add_library(openzzs::mllee INTERFACE IMPORTED)
  set_target_properties(openzzs::mllee PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "@CMAKE_INSTALL_FULL_INCLUDEDIR@")
endif ()

if (NOT TARGET openzzs::sensor_driver)
  add_library(openzzs::sensor_driver STATIC IMPORTED)
  set_target_properties(openzzs::sensor_driver PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "@CMAKE_INSTALL_FULL_INCLUDEDIR@")
endif ()
