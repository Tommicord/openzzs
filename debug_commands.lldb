# OpenZZS ndk-gdb / lldb debug script
# Connect to lldb-server on the device
platform select android
platform connect connect://localhost:5039

# Set symbol paths for the unstripped native library
settings set target.source-map / /home/tommicord/CLionProjects/openzzs/
settings set target.exec-search-paths /home/tommicord/CLionProjects/openzzs/android/app/build/intermediates/cxx/Debug/6o3g5y5l/obj/arm64-v8a

# Attach to the app process
process attach --name com.openzzs

# Set breakpoints at key locations
# Note: C++ inline/template functions may need source-level breakpoints
b Java_com_openzzs_SensrBridge_initNative
b Java_com_openzzs_SensrBridge_feedSampleNative

# Try to break on bank functions (may be inlined, so try source-level too)
b bank_produce_row
b bank_feed_sample
b stage_produce_all

# _feed_grid_sample is a static function in sensr_jni.cpp
b _feed_grid_sample

# Print breakpoint info
breakpoint list

# Continue execution
continue
